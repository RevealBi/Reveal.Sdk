<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when .NET 8 isn't installed (a .NET 9 or 10 SDK alone builds this but can't run it). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DomSamples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating: always the newest Reveal.Sdk.Dom prerelease (the package ships only prereleases). -->
    <PackageReference Include="Reveal.Sdk.Dom" Version="*-*" />
  </ItemGroup>

</Project>
