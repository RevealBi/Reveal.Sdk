<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>reveal-embed</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <java.version>17</java.version>
        <!-- Keep in step with the client reveal-sdk version in static/index.html. -->
        <reveal.version>2.2.1</reveal.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Pulls reveal-sdk-core and the native engine for the OS/CPU the build runs on
             (a Maven profile in reveal-sdk-core picks it). Build the deployable on the
             server's platform, or add that platform's reveal-sdk-engine-* artifact here. -->
        <dependency>
            <groupId>io.revealbi</groupId>
            <artifactId>reveal-sdk-servlet</artifactId>
            <version>${reveal.version}</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>reveal.public</id>
            <url>https://maven.revealbi.io/repository/public/</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
